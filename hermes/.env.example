# 啟用 Dashboard；1 為啟用，0 為停用。
HERMES_DASHBOARD=1

# Dashboard HTTP 伺服器在容器內的綁定位置。
# 使用 0.0.0.0 才能透過 Docker 對外發布 Dashboard。
HERMES_DASHBOARD_HOST=0.0.0.0

# Dashboard HTTP 伺服器與 Docker 對外發布的連接埠。
HERMES_DASHBOARD_PORT=9119

# Dashboard Basic Auth 登入帳號。
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin

# Dashboard Basic Auth 登入密碼；請替換成強密碼。
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# 用於簽署登入 session；固定此值可讓 session 在容器重啟後繼續有效。
# 產生方式：openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-random-secret

# Telegram Bot token；不使用 Telegram 整合時可留空。
TELEGRAM_BOT_TOKEN=
